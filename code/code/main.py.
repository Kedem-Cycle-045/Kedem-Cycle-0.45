def step20_transformation_full():
    print("\n" + "=" * 60)
    print("ШАГ 20: ЗАКОН ТРАНСФОРМАЦИИ — ПОЛНО")
    print("=" * 60)
    print("  Три кванта, три перехода, спираль")


# ==============================================================
# ПРОВЕРКА
# ==============================================================

def run_verification(save=False):
    M21, M20, Z = step1_load()
    if M21 is None:
        print("\nПроверка невозможна без snappy.")
        return

    H, ev, evec = step2_dirac()
    p = step3_p_invariants(evec)
    sum_J = step4_psi_currents()
    S_D = step5_shannon()
    M_base = step6_m_base()
    M_Pl = step7_planck(M_base)
    avg_p = step8_particles(p)
    masses_psi = step9_dark_matter(p, M_base)
    m_nu = step10_neutrino(M_base)
    inv_a = step11_constants()
    eta_B, w = step12_cosmology()
    E_grav = step13_graviton(M_base)
    step14_stellar()
    Q1, Q2, Q3 = step15_transformation()
    step16_evolution()
    step17_ontogenesis()
    step18_neuroscience()
    step19_cancer()
    step20_transformation_full()

    print("\n" + "=" * 60)
    print("ИТОГ ПРОВЕРКИ")
    print("=" * 60)
    print(f"  Ψ-токи: {sum_J:.4f}")
    print(f"  S_D = {S_D:.4f}")
    print(f"  M_base = {M_base:.4f} ГэВ")
    print(f"  M_Planck = {M_Pl:.4e} ГэВ")
    print(f"  28 частиц: {avg_p:.4f}%")
    print(f"  m_ν = {m_nu:.4f} эВ")
    print(f"  1/α_em = {inv_a:.4f}")
    print(f"  η_B = {eta_B:.4e}")
    print(f"  w = {w:.4f}")
    print(f"  E_grav = {E_grav:.4f} ГэВ")

    if save:
        results = {
            "L8a21_volume": float(M21.volume()),
            "L8a21_chern_simons": float(M21.chern_simons()),
            "p_invariants": [float(x) for x in p],
            "psi_currents_K7": float(sum_J),
            "S_D": float(S_D),
            "M_base": float(M_base),
            "M_Planck": float(M_Pl),
            "particles_avg_deviation": float(avg_p),
            "psi_masses": [float(x) for x in masses_psi],
            "m_neutrino": float(m_nu),
            "inv_alpha_em": float(inv_a),
            "eta_B": float(eta_B),
            "w": float(w),
            "E_grav": float(E_grav),
            "Q1": float(Q1),
            "Q2": float(Q2),
            "Q3": float(Q3),
        }
        with open("results.json", "w", encoding="utf-8") as f:
            json.dump(results, f, indent=2, ensure_ascii=False)
        print(f"\n  Результаты сохранены: results.json")


