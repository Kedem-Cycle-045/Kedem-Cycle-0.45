def explore_s_to_mass():
    print("\n--- Поиск массы по S ---")
    try:
        S = float(input("Введите S: "))
        i = int(input("ψ_i (1-7): ")) - 1
        j = int(input("ψ_j (1-7): ")) - 1
        if not (0 <= i <= 6 and 0 <= j <= 6):
            print("ψ должен быть от 1 до 7")
            return
        m = S / (PSI_FREQS[i] * PSI_FREQS[j])
        print(f"\n  m = {m:.6f} МэВ")
    except ValueError:
        print("Ошибка ввода")


def explore_pair():
    print("\n--- Частицы на ψ-паре ---")
    try:
        i = int(input("ψ_i (1-7): ")) - 1
        j = int(input("ψ_j (1-7): ")) - 1
        if not (0 <= i <= 6 and 0 <= j <= 6):
            print("ψ должен быть от 1 до 7")
            return
        base = PSI_FREQS[i] * PSI_FREQS[j]
        print(f"\n  Квант массы: {base:.6f}")
        for S in range(1, 11):
            m = S / base
            print(f"    S={S:2d}: m = {m:.4f} МэВ")
    except ValueError:
        print("Ошибка ввода")


