        ("ψ₃-ψ₇, gen 3", 2350.0), ("ψ₂-ψ₂, gen 1", 57120.0),
        ("ψ₂-ψ₂, gen 2", 99340.0),
    ]
    for name, m in predictions:
        print(f"  {name}: {m:.2f} МэВ")


def explore_boundaries():
    print("\n--- Границы применимости ---")
    print("  Работает: физика, эволюция, онтогенез, нейро, звёзды")
    print("  Не работает: языки, города (R² < 0.03)")


def explore_plots():
    try:
        import matplotlib
        matplotlib.use('Agg')
        import matplotlib.pyplot as plt
    except ImportError:
        print("matplotlib не установлен.")
        return

    fig, axes = plt.subplots(2, 2, figsize=(12, 10))

    axes[0, 0].bar(range(1, 8), P_VALUES)
    axes[0, 0].set_title('p-инварианты')

    masses = [M_BASE * math.sqrt(P_VALUES[0] / P_VALUES[i]) for i in range(7)]
    axes[0, 1].plot(range(1, 8), masses, 'o-')
    axes[0, 1].set_title('Массы ψ-состояний')

    Q1 = 12 * KAPPA
    Q2 = math.log(2)
    Q3 = 1.0
    axes[1, 0].bar(['Q₁', 'Q₂', 'Q₃'], [Q1, Q2, Q3])
    axes[1, 0].set_title('Три кванта')

    theta = np.linspace(0, 6*np.pi, 300)
    r = np.linspace(0, 1, 300)
    axes[1, 1].plot(r * np.cos(theta), r * np.sin(theta))
    axes[1, 1].set_title('Спираль')
    axes[1, 1].set_aspect('equal')

    plt.tight_layout()
    plt.savefig('kedem_plots.png', dpi=100)
    print("\n  График сохранён: kedem_plots.png")


def run_exploration():
    if not is_interactive():
        print("\nИнтерактивное меню недоступно в этой среде (Jupyter/SageMath).")
        print("Запустите из терминала: python main.py --explore")
        return

    print("\n" + "=" * 60)
    print("ИНСТРУМЕНТ ИССЛЕДОВАНИЯ")
    print("=" * 60)

    while True:
        print("\nЧто исследовать?")
        print("  1. Задать S — найти массу")
        print("  2. Задать ψ-пару — найти частицы")
        print("  3. Предсказания новых частиц")
        print("  4. Границы применимости")
        print("  5. Построить графики")
        print("  0. Выход")

        try:
            choice = input("\nВыбор: ").strip()
        except (EOFError, KeyboardInterrupt):
            break

        if choice == "1":
            explore_s_to_mass()
        elif choice == "2":
            explore_pair()
        elif choice == "3":
            explore_predictions()
        elif choice == "4":
            explore_boundaries()
        elif choice == "5":
            explore_plots()
        elif choice == "0":
            break


# ==============================================================
# ГЛАВНЫЙ ЗАПУСК
# ==============================================================

def main():
    args = sys.argv[1:] if len(sys.argv) > 1 else []
    mode = "--all"
    save = False

    for a in args:
        if a in ("--verify", "--explore", "--all"):
            mode = a
        elif a == "--save":
            save = True

    if mode == "--verify":
        run_verification(save=save)
    elif mode == "--explore":
        run_exploration()
    else:
        run_verification(save=save)
