        ("ψ₁-ψ₅, gen 3", 160.24), ("ψ₆-ψ₇, gen 2", 238.09),
        ("ψ₅-ψ₇, gen 3", 267.41), ("ψ₆-ψ₇, gen 3", 407.66),
